    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "eslint-plugin-solid": "~0.18.0",
    "oxfmt": "~0.70.0",
    "oxlint": "~1.85.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@12.3.4"
}
